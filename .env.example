# ── Application ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Language used by the tutor when talking to students: es | en
TUTOR_LOCALE=es

# ── Ollama (local LLM) ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=120

# ── ChromaDB (vector store) ────────────────────────────────────────────
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=material_clase

# ── SQLite (gating & history) ──────────────────────────────────────────
SQLITE_PATH=data/tutor.db

# ── Docker sandbox ─────────────────────────────────────────────────────
SANDBOX_DIR=data/sandbox
SANDBOX_IMAGE=sandbox-evaluador
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_TIMEOUT_SECONDS=60

# ── Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=100000
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_STUDENT_ID_LENGTH=100
MAX_TOPIC_LENGTH=200
MAX_QUERY_LENGTH=500

# ── Documentation ingestion (scripts/ingest_docs.py) ───────────────────
# Point this to the extracted "Python 3.14 documentation" text tree.
DOCS_SOURCE_DIR=C:/Users/mille/Downloads/python-3.14-docs-text/python-3.14-docs-text
