# ── Application ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Language used by the tutor when talking to students: es | en
TUTOR_LOCALE=es

# ── Ollama (local LLM) ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=120
# Context window requested on every generation. A large context does not fit
# in a modest GPU and spills into system RAM, making every answer slow.
OLLAMA_CONTEXT_LENGTH=8192
# How long the model stays in memory after a request. The Ollama default of
# five minutes forces a cold start in the middle of a session.
OLLAMA_KEEP_ALIVE=30m

# ── ChromaDB (vector store) ────────────────────────────────────────────
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=material_clase

# ── SQLite (gating & history) ──────────────────────────────────────────
SQLITE_PATH=data/tutor.db

# ── Docker sandbox ─────────────────────────────────────────────────────
SANDBOX_DIR=data/sandbox
SANDBOX_IMAGE=sandbox-evaluador
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_TIMEOUT_SECONDS=60

# ── Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=100000
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_STUDENT_ID_LENGTH=100
MAX_TOPIC_LENGTH=200
MAX_QUERY_LENGTH=500

# ── Documentation ingestion (scripts/ingest_docs.py) ───────────────────
# Point this to the extracted "Python documentation" text tree.
# It can also be passed on the command line: --source /path/to/docs
DOCS_SOURCE_DIR=data/docs-source
